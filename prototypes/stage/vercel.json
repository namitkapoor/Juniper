{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/gated/:path*",
      "destination": "/api/gated-asset?p=:path*"
    },
    {
      "source": "/((?!api/|gated/|assets/|fonts/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "(www\\.)?namit\\.me"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "private/**"
    }
  }
}
