{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/about",
      "destination": "/?page=about",
      "permanent": false
    },
    {
      "source": "/case-study/chekout",
      "destination": "/?a=ck-merchant-outcomes",
      "permanent": false
    },
    {
      "source": "/case-study/christine-valmy",
      "destination": "/?a=cv-results",
      "permanent": false
    },
    {
      "source": "/case-study/:slug*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/explore",
      "destination": "https://studio.namit.me",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/gated/:path*",
      "destination": "/api/gated-asset?p=:path*"
    },
    {
      "source": "/((?!api/|gated/|assets/|fonts/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "(www\\.)?namit\\.me"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "private/**"
    }
  }
}
